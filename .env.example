# Copy to .env.local and fill in. Never commit .env.local. See README §11.

# OpenRouter (text) — default to OpenAI models routed through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL_STORY=openai/gpt-5.5
OPENROUTER_MODEL_LEARNING=openai/gpt-4o-mini
OPENROUTER_MODEL_GUARD=openai/gpt-4o-mini
OPENROUTER_MODEL_FEEDBACK=openai/gpt-4o-mini
OPENROUTER_MODEL_GRADER=openai/gpt-4o-mini
OPENROUTER_MODEL_JUDGE=openai/gpt-4o
APP_VERSION=development

# Story illustrations (§6.1 Step 4) — via OpenRouter (use a separate key when available)
IMAGE_API_KEY=
IMAGE_MODEL=google/gemini-2.5-flash-image

# Azure Storage — dev via Azurite connection string; prod via Managed Identity + account name
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# AZURE_STORAGE_ACCOUNT=
AZURE_TABLE_NAME=DailyPacks
AZURE_BLOB_CONTAINER=story-images

# Authorizes POST /api/generate. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GENERATE_API_KEY=
